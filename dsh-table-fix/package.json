{
  "name": "dsh-table-fix",
  "version": "1.0.0",
  "description": "DSH Web UI readability fix: Markdown tables keep readable column widths (no per-character CJK wrapping), stay on single-line headers, and scroll horizontally instead of squeezing",
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.0"
  },
  "keywords": [
    "dsh",
    "dsh-bundle",
    "deepseek-harness",
    "markdown",
    "table",
    "css"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
