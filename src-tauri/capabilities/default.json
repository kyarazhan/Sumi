{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "MD 阅读器默认能力：目录/文件读取、文件监听、对话框、系统浏览器打开、导出写入",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-read-dir",
    "fs:allow-watch",
    "fs:allow-unwatch",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "**" },
        { "path": "**/*" }
      ]
    },
    "opener:default"
  ]
}
